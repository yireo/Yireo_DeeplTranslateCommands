<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="yireo_deepltranslatecommands_translate_product" xsi:type="object">Yireo\DeeplTranslateCommands\Console\Command\TranslateProductCommand</item>
                <item name="yireo_deepltranslatecommands_translate_products" xsi:type="object">Yireo\DeeplTranslateCommands\Console\Command\TranslateProductsCommand</item>
                <item name="yireo_deepltranslatecommands_translate_category" xsi:type="object">Yireo\DeeplTranslateCommands\Console\Command\TranslateCategoryCommand</item>
                <item name="yireo_deepltranslatecommands_translate_categories" xsi:type="object">Yireo\DeeplTranslateCommands\Console\Command\TranslateCategoriesCommand</item>
                <item name="yireo_deepltranslatecommands_translate_cms_page" xsi:type="object">Yireo\DeeplTranslateCommands\Console\Command\TranslateCmsPageCommand</item>
                <item name="yireo_deepltranslatecommands_translate_cms_pages" xsi:type="object">Yireo\DeeplTranslateCommands\Console\Command\TranslateCmsPagesCommand</item>
                <item name="yireo_deepltranslatecommands_translate_cms_block" xsi:type="object">Yireo\DeeplTranslateCommands\Console\Command\TranslateCmsBlockCommand</item>
                <item name="yireo_deepltranslatecommands_translate_cms_blocks" xsi:type="object">Yireo\DeeplTranslateCommands\Console\Command\TranslateCmsBlocksCommand</item>
            </argument>
        </arguments>
    </type>
    <type name="Yireo\DeeplTranslateCommands\Service\ContentGuard">
        <arguments>
            <argument name="wysiwygValidator" xsi:type="object">DefaultWYSIWYGValidator</argument>
        </arguments>
    </type>
    <type name="Yireo\DeeplTranslateCommands\Translator\ProductTranslator">
        <arguments>
            <argument name="productAction" xsi:type="object">Magento\Catalog\Model\Product\Action\Proxy</argument>
        </arguments>
    </type>
    <type name="Yireo\DeeplTranslateCommands\Translator\CategoryTranslator">
        <arguments>
            <argument name="categoryResource" xsi:type="object">Magento\Catalog\Model\ResourceModel\Category\Proxy</argument>
        </arguments>
    </type>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="yireo_deepl_translate/general/api_key" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
</config>
